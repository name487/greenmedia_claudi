# Database. PostgreSQL (recommended; `docker compose up -d db` starts one locally):
DATABASE_URL=postgresql+psycopg://greenmedia:greenmedia@127.0.0.1:5432/greenmedia
# …or a zero-setup SQLite file for quick demos:
# DATABASE_URL=sqlite:///./greenmedia.db

# JWT signing secret — generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

# Seed the demo agency (24 clients, 6 users, password demo1234) when the DB is empty.
# For real use set 0 and create your first admin: python -m app.manage create-admin --email you@agency.com --name "Your Name"
SEED_DEMO=1

# AI review replies, content and reports. Leave keys empty to use the built-in brand-voice templates.
# OpenAI: create a key at https://platform.openai.com/api-keys (the project needs billing/credit).
OPENAI_API_KEY=
# Model (default gpt-4.1-mini for OpenAI, claude-sonnet-5 for Anthropic)
AI_MODEL=
# openai | anthropic. Leave empty: OpenAI when OPENAI_API_KEY is set, otherwise Anthropic.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Optional: OpenAI-compatible gateway, organization and project headers
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORG_ID=
OPENAI_PROJECT_ID=

# Browser origins allowed to call the API directly (Django and Flutter do not need CORS).
CORS_ORIGINS=http://127.0.0.1:8000

# ---- Google Business Profile (live) ----
# OAuth "Web application" client from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" on that client (exactly — 127.0.0.1 and localhost are different)
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/google/callback
# Where the browser returns after connecting (Django web app). Must be the same address you open the app at.
WEB_APP_URL=http://127.0.0.1:8000
# Encrypts stored Google refresh tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Sync live Google profiles + publish due scheduled posts every N minutes (0 = off)
SCHEDULER_INTERVAL_MINUTES=15

# AI Review Queue: show labelled sample reviews while Google API approval is pending (quota 0) or a client isn't
# linked yet. They are never posted to Google and are removed when real reviews arrive. 0 = never create them.
REVIEW_SAMPLE_DATA=1
# New reviews that get an AI-drafted reply per client per sync
REVIEW_AUTODRAFT_LIMIT=20

# Scheduled publishing with Redis + Celery (docker compose up -d redis), then from backend/:
#   celery -A app.celery_app worker -B -l info
# Leave empty to run without Redis: Publish now works inline and SCHEDULER_INTERVAL_MINUTES publishes due posts.
REDIS_URL=
# Temporary publish errors (rate limits, 5xx, network) are retried: first after N minutes, doubling, up to N attempts
CONTENT_PUBLISH_MAX_ATTEMPTS=3
CONTENT_RETRY_MINUTES=2
# Celery beat: how often live Google profiles are synced
GOOGLE_SYNC_MINUTES=30

# Facebook Pages + Instagram via the Meta Graph API (developers.facebook.com → Business app → Facebook Login for Business).
# Add META_REDIRECT_URI as a "Valid OAuth Redirect URI" in the app. Leave empty to keep Facebook/Instagram simulated.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://127.0.0.1:8001/api/meta/callback
META_GRAPH_VERSION=v23.0

# Mobile app sign-in with phone + SMS code. console = code only in the server log (demo installs also show it in the app).
# India: nimbusit or msg91 (DLT-approved OTP template). Leave SMS_PROVIDER empty and fill SMS_AUTHKEY
# to use NimbusIT.
SMS_PROVIDER=
# NimbusIT (from your NimbusIT panel). SMS_TEXT must be your DLT-approved template word for word, with {otp} where the
# code goes — paste it as DLT shows it, with {#var#} (or {otp}) for the code, e.g.
# SMS_TEXT="Dear customer, your OTP is {#var#}. Your code is valid for 3 mins." — and set OTP_TTL_SECONDS to match (180).
# Without SMS_TEXT nothing is sent and the app shows what is missing.
SMS_HOST=nimbusit.net
SMS_USER=
SMS_AUTHKEY=
SMS_SENDER=
SMS_ENTITYID=
SMS_TEMPLATEID=
SMS_RPT=1
SMS_TEXT=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_SECONDS=30
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
