# Frontend: where the mobile/desktop apps reach the API. Leave empty to run fully offline (demo data + local AI templates).
VITE_API_URL=http://localhost:8787

# Server (server/index.mjs)
PORT=8787
# anthropic | openai
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Comma-separated list of origins allowed to call the API (capacitor://localhost and https://localhost are the mobile shells)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,https://localhost,app://.
