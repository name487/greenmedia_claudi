# Database. PostgreSQL (recommended; `docker compose up -d db` starts one locally):
DATABASE_URL=postgresql+psycopg://greenmedia:greenmedia@127.0.0.1:5432/greenmedia
# …or a zero-setup SQLite file for quick demos:
# DATABASE_URL=sqlite:///./greenmedia.db

# JWT signing secret — generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

# Seed the demo agency (24 clients, 6 users, password demo1234) when the DB is empty.
# For real use set 0 and create your first admin: python -m app.manage create-admin --email you@agency.com --name "Your Name"
SEED_DEMO=1

# AI: anthropic | openai. Leave keys empty to use the built-in templates.
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Browser origins allowed to call the API directly (Django and Flutter do not need CORS).
CORS_ORIGINS=http://127.0.0.1:8000

# ---- Google Business Profile (live) ----
# OAuth "Web application" client from Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must be listed under "Authorized redirect URIs" on that client (exactly — 127.0.0.1 and localhost are different)
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/api/google/callback
# Where the browser returns after connecting (Django web app). Must be the same address you open the app at.
WEB_APP_URL=http://127.0.0.1:8000
# Encrypts stored Google refresh tokens: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# Sync live Google profiles + publish due scheduled posts every N minutes (0 = off)
SCHEDULER_INTERVAL_MINUTES=15

# AI Review Queue: show labelled sample reviews while Google API approval is pending (quota 0) or a client isn't
# linked yet. They are never posted to Google and are removed when real reviews arrive. 0 = never create them.
REVIEW_SAMPLE_DATA=1
# New reviews that get an AI-drafted reply per client per sync
REVIEW_AUTODRAFT_LIMIT=20
