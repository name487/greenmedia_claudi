# Database: SQLite for local dev; use PostgreSQL in production, e.g.
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/greenmedia
DATABASE_URL=sqlite:///./greenmedia.db

# JWT signing secret — generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_TTL_MINUTES=720

# Seed the demo agency (24 clients, 6 users, password demo1234) when the DB is empty. Set 0 in production.
SEED_DEMO=1

# AI: anthropic | openai. Leave keys empty to use the built-in templates.
AI_PROVIDER=anthropic
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Browser origins allowed to call the API directly (Django and Flutter do not need CORS).
CORS_ORIGINS=http://localhost:8000
